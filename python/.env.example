CAREFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Omi Med STT: the model, engine, backend, threads and timings are chosen on the app's Configuration
# page and saved to python/stt_settings.json. The values below are only the defaults before that file exists.
# CAREFLOW_STT_ENGINE=mock gives a fixed transcript without loading any model (wiring tests).
CAREFLOW_STT_PRELOAD=1          # load the model at startup so the first request is fast
CAREFLOW_STT_THREADS=0          # 0 = runtime default
# parakeet.cpp backend for GGUF models: cpu (prebuilt) | cuda | vulkan (both built from source: CMake + CUDA Toolkit/Vulkan SDK + compiler)
CAREFLOW_STT_BACKEND=cpu
# LLM: ollama | llamacpp
CAREFLOW_LLM_RUNTIME=ollama
CAREFLOW_LLM_URL=http://127.0.0.1:11434
CAREFLOW_LLM_MODEL=qwen3.5:4b
CAREFLOW_LLM_TIMEOUT=120
# Live streaming: pause (ms) that ends an utterance, and how often the partial transcript refreshes
CAREFLOW_STT_ENDPOINT_MS=900
CAREFLOW_STT_PARTIAL_MS=500
