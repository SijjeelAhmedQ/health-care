CAREFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STT: gguf | mlx | mock
CAREFLOW_STT_ENGINE=gguf
CAREFLOW_STT_MODEL_PATH=models/omi-med-stt-v1.gguf      # gguf engine
CAREFLOW_STT_MODEL=omi-health/omi-med-stt-v1-mlx-q8      # mlx engine (HF repo id)
# LLM: ollama | llamacpp
CAREFLOW_LLM_RUNTIME=ollama
CAREFLOW_LLM_URL=http://127.0.0.1:11434
CAREFLOW_LLM_MODEL=qwen3.5:4b
CAREFLOW_LLM_TIMEOUT=30
