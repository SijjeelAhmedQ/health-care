CAREFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STT engine: auto | gguf | mlx | mlx-q8 | mock
#   gguf   -> omi-health/omi-med-stt-v1-gguf   (Linux/Windows CPU, parakeet.cpp)
#   mlx    -> omi-health/omi-med-stt-v1-mlx    (Apple Silicon, full precision)
#   mlx-q8 -> omi-health/omi-med-stt-v1-mlx-q8 (Apple Silicon, 8-bit)
#   auto   -> mlx-q8 on Apple Silicon, gguf elsewhere
CAREFLOW_STT_ENGINE=auto
CAREFLOW_STT_PRELOAD=1          # load the model at startup so the first request is fast
CAREFLOW_STT_THREADS=0          # 0 = runtime default
# parakeet.cpp backend for the gguf engine: cpu (prebuilt) | cuda | vulkan (both built from source: CMake + CUDA Toolkit/Vulkan SDK + compiler)
CAREFLOW_STT_BACKEND=cpu
# LLM: ollama | llamacpp
CAREFLOW_LLM_RUNTIME=ollama
CAREFLOW_LLM_URL=http://127.0.0.1:11434
CAREFLOW_LLM_MODEL=qwen3.5:4b
CAREFLOW_LLM_TIMEOUT=30
