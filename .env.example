# ---- Assistant: speech ----
# Omi Med STT, streamed live from the Python bridge (python/app.py -> /ws/stt).
VITE_STT_WS_URL=ws://127.0.0.1:8765/ws/stt

# ---- Assistant: model (tool calling) ----
# ollama            -> Ollama /api/chat with native tool calling (qwen3.5:4b)
# openai-compatible -> llama.cpp server / LM Studio / mlx_lm.server /v1/chat/completions
# bridge            -> the Python bridge's /api/chat (VITE_LLM_API_URL=http://127.0.0.1:8765)
VITE_LLM_PROVIDER=ollama
VITE_LLM_API_URL=http://127.0.0.1:11434
VITE_LLM_MODEL=qwen3.5:4b
# The first request after start-up loads the model and ~8k tokens of tool schemas.
VITE_LLM_TIMEOUT_MS=90000
# GPU offload: 99 = every layer on the GPU. Without it Ollama may split the model and run ~3x slower.
VITE_LLM_NUM_GPU=99
# Context window: system prompt + tool schemas (~8k tokens) + conversation + tool results.
VITE_LLM_NUM_CTX=12288
# Most model calls one utterance may take (tool call -> result -> next tool ... -> reply).
VITE_AGENT_MAX_STEPS=8

# ---- Feature flags ----
VITE_ENABLE_VOICE=true
VITE_ENABLE_DEBUG_PANEL=true
VITE_APP_NAME=CareFlow PMS
