# ---- AI runtime configuration ----
# mock  -> deterministic rule-based interpreter, no models required (default for development)
# local -> use the local model bridge / runtimes configured below
VITE_AI_MODE=mock

# Speech-to-text provider: mock | browser | http
#   browser -> Web Speech API (Chrome/Edge) — no model required
#   http    -> POST audio to VITE_STT_API_URL (python bridge running omi-med-stt)
VITE_STT_PROVIDER=browser
VITE_STT_API_URL=http://127.0.0.1:8765/api/stt

# LLM provider: mock | ollama | openai-compatible | http
#   ollama            -> Ollama /api/chat (qwen3.5:4b)
#   openai-compatible -> llama.cpp server / LM Studio / MLX server /v1/chat/completions
#   http              -> python bridge POST VITE_LLM_API_URL
VITE_LLM_PROVIDER=ollama
VITE_LLM_API_URL=http://127.0.0.1:11434
VITE_LLM_MODEL=qwen3.5:4b
VITE_LLM_TIMEOUT_MS=20000

# Fall back to the deterministic interpreter when the LLM is unreachable or returns invalid JSON
VITE_AI_FALLBACK_TO_RULES=true

# ---- Feature flags ----
VITE_ENABLE_VOICE=true
VITE_ENABLE_DEBUG_PANEL=true
VITE_APP_NAME=CareFlow PMS
